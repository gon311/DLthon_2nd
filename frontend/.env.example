# Kakao Developers > App > Platform key > JavaScript key
# Register the deployed frontend origin as an allowed JavaScript SDK domain.
KAKAO_JS_KEY=replace_with_kakao_javascript_key

# FastAPI base URL. Falls back to local synthetic seed data when unavailable.
API_BASE_URL=http://localhost:8000/api/v1

# Keep Kakao REST/Admin keys server-side only; never prefix them with PUBLIC_.
# KAKAO_REST_API_KEY=replace_with_server_only_rest_key
